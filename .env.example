# Disposable local development credentials, never production credentials.
CELERITY_DATABASE_URL=postgresql+psycopg://celerity:celerity_dev_only@127.0.0.1:55432/celerity
CELERITY_SHIPPING_URL=http://127.0.0.1:8001
CELERITY_ENABLE_N_PLUS_ONE=false
CELERITY_ENABLE_MISSING_INDEX=false
CELERITY_ENABLE_REDUNDANT_SHIPPING=false
CELERITY_SHIPPING_DELAY_MS=40
CELERITY_TELEMETRY_ENABLED=true
CELERITY_TELEMETRY_DIR=var/traces
CELERITY_TELEMETRY_SAMPLE_RATIO=1.0
# Optional: set after starting Jaeger. Blank means local JSONL traces only.
CELERITY_OTLP_ENDPOINT=

